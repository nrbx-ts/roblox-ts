{
	"compilerOptions": {
		"declaration": true,
		"module": "nodenext",
		"target": "ES2019",
		"lib": ["ES2022", "ESNext.Disposable"],
		"types": ["@types/node"],
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"strictNullChecks": true,
		"esModuleInterop": true,
		"removeComments": true,
		"forceConsistentCasingInFileNames": true,
		"composite": true,
		"sourceMap": true,
		"outDir": "out",
		"rootDir": "src",
		"paths": {
			"*": ["./src/*"]
		}
	},
	"include": ["src"],
	"exclude": ["src/cli/test.ts"]
}
